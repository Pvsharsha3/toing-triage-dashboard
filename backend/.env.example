# Set MOCK_MODE=false and fill in Snowflake creds for live queries
MOCK_MODE=true

# Snowflake (key-pair auth — no SSO, works server-side)
# Generate: openssl genrsa -out rsa_key.pem 2048
# Register the public key with Snowflake, then set:
SF_USER=your.email@swiggy.in
SF_ACCOUNT=GZAVXAB-SWIGGY_MUMBAI
SF_WAREHOUSE=ANALYST_SCHEDULES_WH_02
SF_ROLE=FOOD_RANDG
SF_DATABASE=ANALYTICS
SF_SCHEMA=PUBLIC

# Provide ONE of:
SF_PRIVATE_KEY_PATH=rsa_key.pem        # local path to RSA private key
SF_PRIVATE_KEY_B64=                    # base64-encoded key (for Render secrets)
